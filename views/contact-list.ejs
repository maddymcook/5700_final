<!-- Page Title -->
<div class="page-title" data-aos="fade">
    <div class="heading">
      <div class="container text-center">
        <h1>Contact Requests</h1>
        <p class="mb-0">
          View and respond to contact requests that have not yet received a reply.
        </p>
      </div>
    </div>
  
    <nav class="breadcrumbs">
      <div class="container">
        <ol>
          <li><a href="/">Home</a></li>
          <li class="current">Contact Requests</li>
        </ol>
      </div>
    </nav>
  </div>
  
  <section class="section">
    <div class="container" data-aos="fade-up">
      <% if (!contacts || contacts.length === 0) { %>
        <p>No pending contact requests. 🎉</p>
      <% } else { %>
        <div class="table-responsive">
          <table class="table align-middle">
            <thead>
              <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Subject</th>
                <th>Received</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% contacts.forEach(contact => { %>
                <tr>
                  <td><%= contact.name %></td>
                  <td><%= contact.email %></td>
                  <td><%= contact.subject || '' %></td>
                  <td>
                    <%= contact.createdAt
                          ? contact.createdAt.toLocaleString()
                          : '' %>
                  </td>
                  <td>
                    <a
                      href="/contacts/admin/respond/<%= contact._id %>"
                      class="btn btn-primary btn-sm"
                    >
                      Respond
                    </a>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </section>
  